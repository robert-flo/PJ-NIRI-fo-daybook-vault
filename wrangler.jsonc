{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daybook",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/en_US",
      "/en_US/",
      "/en_US/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daybook-stats",
      "database_id": "e13eeb32-e112-4dd8-8f36-a30c244f59b9"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITE_PRESENCE",
        "class_name": "SitePresence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SitePresence"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "GITHUB_CACHE",
      "id": "4bb4c81ff8b34d92a62611351a6eca15"
    }
  ],
  "vars": {
    "GITHUB_USERNAME": "robert-flo"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
